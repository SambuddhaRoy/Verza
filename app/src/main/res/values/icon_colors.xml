<?xml version="1.0" encoding="utf-8"?>
<!-- The app mark. There used to be eight of these, one per hue, for a launcher icon that followed
     the music; swapping between them meant disabling the component the running task was rooted at,
     which Android answers by destroying the task. -->
<resources>
    <color name="icon_bg_indigo">#3B2FA8</color>
    <color name="icon_fg_indigo">#EDF27A</color>

    <!-- The launch canvas. Must equal DefaultExpressiveColors.container, or the system splash and
         the boot screen that replaces it are two different indigos and the handover shows. -->
    <color name="splash_bg">#5B4BE0</color>
</resources>
