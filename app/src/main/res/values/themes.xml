<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Verza</string>
    <color name="icon_bg_indigo">#3B2FA8</color>
    <color name="icon_fg_indigo">#EDF27A</color>

    <!-- The window is the canvas Compose paints, so launch shows the same white or black, no flash. -->
    <style name="Theme.Verza" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
