<?xml version="1.0" encoding="utf-8"?>
<!-- The Poster widget's controls: previous, the wide PLAY pill, next. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">

        <ImageView
            android:id="@+id/widget_previous_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_shape_circle"
            android:tint="@color/widget_surface" />

        <ImageView
            android:id="@+id/widget_previous"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_previous"
            android:padding="12dp"
            android:src="@drawable/ic_widget_previous"
            android:tint="@color/widget_on_surface" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_toggle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_play">

        <ImageView
            android:id="@+id/widget_toggle_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_shape_pill"
            android:tint="@color/widget_accent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_toggle_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_play"
                android:tint="@color/widget_on_accent" />

            <TextView
                android:id="@+id/widget_toggle_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="@string/widget_play_label"
                android:textColor="@color/widget_on_accent"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">

        <ImageView
            android:id="@+id/widget_next_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_shape_circle"
            android:tint="@color/widget_surface" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_next"
            android:padding="12dp"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_on_surface" />
    </FrameLayout>
</LinearLayout>
