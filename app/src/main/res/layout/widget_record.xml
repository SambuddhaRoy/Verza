<?xml version="1.0" encoding="utf-8"?>
<!-- Record: the cover as the label of a vinyl on a scalloped mat. The tonearm drops onto the record
     while it plays and swings off when it pauses. The record is drawn as one bitmap so the label
     stays in proportion at any size; the arm uses the same square so the two line up. Loose shapes
     get the same cream rim as the stickers. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_record_preview" />

    <ImageView
        android:id="@+id/widget_arm"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_tonearm_off"
        android:tint="@color/widget_accent" />

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|start">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_shape_flower8"
            android:tint="@color/widget_paper" />

        <ImageView
            android:id="@+id/widget_toggle_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_shape_flower8"
            android:tint="@color/widget_accent" />

        <ImageView
            android:id="@+id/widget_toggle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_play"
            android:padding="16dp"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_on_accent" />
    </FrameLayout>
</FrameLayout>
