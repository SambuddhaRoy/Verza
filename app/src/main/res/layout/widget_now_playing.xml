<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately plain. A widget is drawn by the launcher's process against the launcher's theme,
     so the cover-derived palette the rest of the app uses is not available here; trying to fake it
     produces something that matches neither Verza nor the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_previous"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Previous"
        android:padding="8dp"
        android:src="@drawable/ic_widget_previous" />

    <ImageView
        android:id="@+id/widget_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Play or pause"
        android:padding="8dp"
        android:src="@drawable/ic_tile_play" />

    <ImageView
        android:id="@+id/widget_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Next"
        android:padding="8dp"
        android:src="@drawable/ic_widget_next" />
</LinearLayout>
