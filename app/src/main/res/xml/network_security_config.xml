<?xml version="1.0" encoding="utf-8"?>
<!--
    Plain http is refused as usual, except to this phone itself, so a lossless source running on the
    device (Termux, say) needs no certificate. Nothing here widens what the app trusts remotely.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
