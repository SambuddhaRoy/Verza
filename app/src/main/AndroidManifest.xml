<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Verza is sideloaded, so it installs its own updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Music on the phone, read only. READ_MEDIA_AUDIO from 13, the storage permission below. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:name=".VerzaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Verza">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A "listen along" link: verza://session/<payload>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="verza" android:host="session" />
            </intent-filter>
            <!-- Share > Verza from YouTube or anywhere: text with a YouTube link in it plays here. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- youtu.be links can open here. Only the short host, so youtube.com browsing isn't taken. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="youtu.be" />
                <data android:scheme="http" android:host="youtu.be" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver android:name=".data.InstallResult" android:exported="false" />
        <!-- Home-screen widget. Not exported: the only thing that sends it these actions is its
             own PendingIntents, and the transport commands would otherwise be open to any app. -->
        <receiver
            android:name="com.verza.widget.NowPlayingWidget"
            android:exported="false"
            android:label="@string/widget_strip_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.verza.widget.TOGGLE" />
                <action android:name="com.verza.widget.NEXT" />
                <action android:name="com.verza.widget.PREVIOUS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>
        <!-- The other widgets only draw. Their buttons send to NowPlayingWidget above, which is the
             one receiver that handles transport. -->
        <receiver
            android:name="com.verza.widget.StickerWidget"
            android:exported="false"
            android:label="@string/widget_sticker_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sticker_info" />
        </receiver>
        <receiver
            android:name="com.verza.widget.PosterWidget"
            android:exported="false"
            android:label="@string/widget_poster_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_poster_info" />
        </receiver>
        <receiver
            android:name="com.verza.widget.RecordWidget"
            android:exported="false"
            android:label="@string/widget_record_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_record_info" />
        </receiver>
        <receiver
            android:name="com.verza.widget.TotemWidget"
            android:exported="false"
            android:label="@string/widget_totem_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_totem_info" />
        </receiver>
        <!-- Play/pause from the notification shade. BIND_QUICK_SETTINGS_TILE is what stops
             anything other than SystemUI binding this. -->
        <service
            android:name="com.verza.tile.PlayPauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_play"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
