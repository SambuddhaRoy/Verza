<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Verza is sideloaded rather than on Play, so it updates itself: this lets it hand a
         downloaded APK to the system installer, which still shows its own confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Required by android.media.audiofx.Visualizer for reading FFT data from ExoPlayer's audio
        session. The Visualizer is used purely for the background-glow sound-reactivity feature;
        the app never records audio from the microphone. Permission is only requested at runtime
        when the user explicitly enables "Sound reactivity" in Settings.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Music-synced haptics ("Feel the beat") — short vibration pulses on the bass. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Attach the equaliser / bass-boost / loudness audio effects to ExoPlayer's session. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        Read on-device audio files for the local-library feature. READ_MEDIA_AUDIO is the
        granular media permission on Android 13+ (API 33); older versions fall back to
        READ_EXTERNAL_STORAGE, capped at API 32 since 33+ ignores it. Read-only — the app
        never writes to or deletes the user's media.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".VerzaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Verza">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Verza.Starting"
            android:windowSoftInputMode="adjustResize">
            <!-- The launcher entry, back on the Activity itself.

                 It lived on an activity-alias so the colour variants could take turns holding
                 it. Switching between them means disabling the alias the running task is rooted
                 at, and Android destroys that task when you do — the app vanished mid-song while
                 the playback service carried on, and the home-screen shortcut, which points at the
                 component by name, was left pointing at something disabled. There is no ordering
                 that avoids this: the switch *is* disabling the component you are running on. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Shared listening sessions: verza://session/<payload> opens here. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="verza" android:host="session" />
            </intent-filter>

            <!-- "Share → Verza" from YouTube (or any app): a text/plain share carrying a YouTube
                 link is parsed and the song plays here instead. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Opening a youtu.be share link directly: offer Verza as a handler. Scoped to the
                 short-link host so we don't intercept ordinary youtube.com browsing. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="youtu.be" />
                <data android:scheme="http" android:host="youtu.be" />
            </intent-filter>
        </activity>

        <!-- Android Auto. Without this the car never lists Verza, however well the session
             behaves. The referenced file declares which of Auto's features we support. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Home-screen widget. Not exported: the only thing that sends it these actions is its
             own PendingIntents, and the transport commands would otherwise be open to any app. -->
        <receiver
            android:name="com.verza.widget.NowPlayingWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.verza.widget.TOGGLE" />
                <action android:name="com.verza.widget.NEXT" />
                <action android:name="com.verza.widget.PREVIOUS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>
        <!-- Play/pause from the notification shade. BIND_QUICK_SETTINGS_TILE is what stops
             anything other than SystemUI binding this. -->
        <service
            android:name="com.verza.tile.PlayPauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_play"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name="com.verza.player.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>



        <!-- Hands exported share-card images to other apps with a temporary read grant. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
